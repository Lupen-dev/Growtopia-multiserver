# Jarvis sesli ajan ayarlari. Bu dosyayi .env olarak kopyala ve doldur (.env git'e girmez).
# Basit ve bedava yol: TELEGRAM (docs/JARVIS_TELEGRAM.md). Gercek WhatsApp/telefon aramasi: TWILIO (docs/JARVIS_WHATSAPP.md).

# --- Genel ---
JARVIS_ENABLED=1                 # 1: ac, 0: kapali (varsayilan kapali)
# JARVIS_CHANNEL=telegram        # telegram | whatsapp | phone (bos: TELEGRAM_BOT_TOKEN varsa telegram, yoksa whatsapp)
JARVIS_CALL_TIME=06:00           # Her gun bu saatte arar
JARVIS_TIMEZONE=Europe/Istanbul  # Bos birakilirsa config/default.json -> server.timezone
JARVIS_SCHEDULE=1                # 0: zamanlayici kapali, sadece elle ("jarvis ara" / bota "ara")
JARVIS_NAME=Jarvis
JARVIS_OWNER_NAME=efendim        # Ajanin sana hitabi ("efendim", "Cafer" ...)

# --- Claude (beyin) ---
ANTHROPIC_API_KEY=sk-ant-xxxx
JARVIS_MODEL=claude-opus-5
JARVIS_EFFORT=low                # low | medium | high  (sesli konusmada gecikme icin low)
JARVIS_FALLBACKS=1               # Guvenlik reddinde sunucu tarafi model fallback'i (kabul edilmezse otomatik kapanir)
JARVIS_DRY_RUN=0                 # 1: Claude yerine sabit cevaplar (API anahtarsiz boru hatti testi)

# ============ TELEGRAM (bedava, basit) ============
TELEGRAM_BOT_TOKEN=123456:ABC-DEF   # @BotFather -> /newbot
TELEGRAM_CHAT_ID=                   # Bos birak, bota bir mesaj yaz, ID'ni soyler. Ya da @kullaniciadin yaz.
CALLMEBOT_USER=@kullaniciadin       # Telefonun gercekten calsin istiyorsan: @CallMeBot_txtbot'a /start yaz, buraya Telegram kullanici adini gir
CALLMEBOT_LANG=tr-TR-Standard-A     # Aramada okuyan ses (Google standart sesler: tr-TR-Standard-A..E)
# CALLMEBOT_REPEAT=1                # Ozeti kac kez okusun (1-3)
JARVIS_TTS=1                        # Cevaplari sesli mesaj olarak da gonder (Edge TTS, anahtar gerekmez)
JARVIS_TTS_VOICE=tr-TR-EmelNeural   # veya tr-TR-AhmetNeural
GROQ_API_KEY=                       # Sesli mesajla soru sormak icin (console.groq.com, ucretsiz, kart istemez). Bos: sadece yazarak sor

# ============ TWILIO (gercek WhatsApp / telefon aramasi) ============
# JARVIS_PUBLIC_URL=https://xxxx.ngrok-free.app   # Twilio'nun sunucuya ulasacagi HTTPS adres (ngrok/cloudflared/VPS)
# JARVIS_TO=+905551112233          # Aranacak numara (senin WhatsApp'in). Kanal whatsapp ise otomatik whatsapp: eklenir
# JARVIS_FROM=+447700900123        # Twilio WhatsApp sender (isletme numarasi). DIKKAT: +90 olamaz (Meta kisiti)
# JARVIS_GREETING=Günaydın efendim, gece raporu hazır. Şimdi mi anlatayım?   # Arama acilinca okunan ilk cumle
# TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# TWILIO_AUTH_TOKEN=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx      # Webhook imza dogrulamasi icin sart
# TWILIO_API_KEY=SKxxxxxxxx        # Istege bagli: REST cagrilari icin API key/secret kullan
# TWILIO_API_SECRET=xxxxxxxx
# JARVIS_PERMISSION_CONTENT_SID=HXxxxx   # Istege bagli: hazir VOICE_CALL_REQUEST sablonu (yoksa otomatik olusturulur)
# JARVIS_VALIDATE_SIGNATURES=1     # Yerel testte (scripts/jarvis-simulate.js) 0 yapabilirsin
# JARVIS_LANGUAGE=tr-TR
# JARVIS_TTS_PROVIDER=Google       # Google | Amazon | ElevenLabs
# JARVIS_VOICE=tr-TR-Wavenet-B     # Google: tr-TR-Wavenet-A..E, Amazon: Burcu-Neural / Filiz
# JARVIS_STT_PROVIDER=Deepgram     # Deepgram | Google
# JARVIS_SPEECH_MODEL=nova-2-general   # Deepgram nova-2 Turkce destekler; Google icin: long / telephony
