{
  "name": "growtopia-multiserver",
  "version": "1.0.0",
  "description": "Eglenceli, cok komutlu, web panelli ozel Growtopia sunucusu (macOS/Linux)",
  "main": "src/index.js",
  "type": "commonjs",
  "scripts": {
    "start": "node src/index.js",
    "dev": "node src/index.js --dev",
    "seed": "node scripts/seed.js",
    "reset": "node scripts/reset.js",
    "gen-cert": "node scripts/gen-cert.js",
    "portfwd": "bash scripts/portfwd.sh",
    "doctor": "bash scripts/doctor.sh",
    "test": "node --test test/*.test.js",
    "jarvis:chat": "node scripts/jarvis-chat.js",
    "jarvis:simulate": "node scripts/jarvis-simulate.js"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.126.0",
    "express": "^4.19.2",
    "growtopia.js": "^2.2.0",
    "msedge-tts": "^2.0.7",
    "twilio": "^6.1.1",
    "ws": "^8.17.0"
  },
  "keywords": [
    "growtopia",
    "private-server",
    "game-server",
    "multiserver"
  ],
  "license": "MIT"
}
